#!/usr/bin/env node

/**
 * CodeAtlas Command Line Interface (CLI)
 *
 * Usage:
 *   node atlas generate-key [options]
 *   node atlas key:generate [options]
 *   ./atlas generate-key [options]
 */

import { spawnSync } from "node:child_process";
import * as crypto from "node:crypto";
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const ROOT_DIR = __dirname;
const ENV_PATH = path.join(ROOT_DIR, ".env");
const ENV_EXAMPLE_PATH = path.join(ROOT_DIR, ".env.example");

// ANSI color formatting
const c = {
  reset: "\x1b[0m",
  bold: "\x1b[1m",
  green: "\x1b[32m",
  cyan: "\x1b[36m",
  yellow: "\x1b[33m",
  red: "\x1b[31m",
  dim: "\x1b[2m",
};

function printBanner() {
  console.log(`\n${c.cyan}${c.bold}CodeAtlas CLI${c.reset} ${c.dim}(atlas)${c.reset}\n`);
}

function printHelp() {
  printBanner();
  console.log(`${c.bold}USAGE:${c.reset}`);
  console.log(`  node atlas <command> [options]\n`);
  console.log(`${c.bold}AVAILABLE COMMANDS:${c.reset}`);
  console.log(`  ${c.green}generate-key${c.reset} (or ${c.green}key:generate${c.reset})   Generate API_KEY_PEPPER and save to .env`);
  console.log(`  ${c.green}generate-api-key${c.reset}                 Generate a new CodeAtlas API Key (ca_...)`);
  console.log(`  ${c.green}migrate-firestore${c.reset}                Migrate Firestore users, API keys, and projects into SQLite`);
  console.log(`  ${c.green}help${c.reset}                             Show this help message\n`);
  console.log(`${c.bold}OPTIONS:${c.reset}`);
  console.log(`  ${c.yellow}--show${c.reset}       Display key only; do not write to .env`);
  console.log(`  ${c.yellow}--all${c.reset}        Generate both API_KEY_PEPPER and CODEATLAS_API_KEY`);
  console.log(`  ${c.yellow}--bytes=<n>${c.reset}  Key size in bytes (default: 32 for 256-bit / 64 hex chars)\n`);
}

/**
 * Update or append an environment variable in .env
 */
function updateEnvVariable(envContent, key, value) {
  const pattern = new RegExp(`^${key}=.*$`, "m");
  if (pattern.test(envContent)) {
    return envContent.replace(pattern, `${key}=${value}`);
  }

  // Try inserting under Security section if present
  const securityHeader = /# ── Security ──+/;
  if (securityHeader.test(envContent)) {
    return envContent.replace(securityHeader, (match) => `${match}\n${key}=${value}`);
  }

  // Otherwise append at EOF
  const trailingNewline = envContent.endsWith("\n") ? "" : "\n";
  return `${envContent}${trailingNewline}${key}=${value}\n`;
}

function handleGenerateKey(args) {
  printBanner();

  const showOnly = args.includes("--show") || args.includes("--dry-run");
  const generateAll = args.includes("--all");
  const byteArg = args.find((a) => a.startsWith("--bytes="));
  const byteCount = byteArg ? Number.parseInt(byteArg.split("=")[1], 10) : 32;

  if (Number.isNaN(byteCount) || byteCount < 16) {
    console.error(`${c.red}Error: --bytes must be at least 16.${c.reset}`);
    process.exit(1);
  }

  // 1. Generate pepper (64 hex characters for 32 bytes)
  const pepper = crypto.randomBytes(byteCount).toString("hex");
  // 2. Generate client API key (ca_<32 hex chars>)
  const apiKey = `ca_${crypto.randomBytes(16).toString("hex")}`;

  console.log(`${c.green}✓${c.reset} Generated ${c.bold}API_KEY_PEPPER${c.reset} (${byteCount * 8}-bit entropy):`);
  console.log(`  ${c.cyan}${pepper}${c.reset}\n`);

  if (generateAll) {
    console.log(`${c.green}✓${c.reset} Generated ${c.bold}CODEATLAS_API_KEY${c.reset}:`);
    console.log(`  ${c.cyan}${apiKey}${c.reset}\n`);
  }

  if (showOnly) {
    console.log(`${c.dim}(Dry run: .env was not modified)${c.reset}\n`);
    return;
  }

  // Prepare .env
  let envContent = "";
  if (fs.existsSync(ENV_PATH)) {
    envContent = fs.readFileSync(ENV_PATH, "utf8");
  } else if (fs.existsSync(ENV_EXAMPLE_PATH)) {
    envContent = fs.readFileSync(ENV_EXAMPLE_PATH, "utf8");
    console.log(`${c.yellow}ℹ${c.reset} Created ${c.bold}.env${c.reset} from .env.example`);
  }

  envContent = updateEnvVariable(envContent, "API_KEY_PEPPER", pepper);
  if (generateAll) {
    envContent = updateEnvVariable(envContent, "CODEATLAS_API_KEY", apiKey);
  }

  fs.writeFileSync(ENV_PATH, envContent, "utf8");
  console.log(`${c.green}✔ Application key successfully saved to .env!${c.reset}\n`);
}

function handleGenerateApiKey() {
  printBanner();
  const apiKey = `ca_${crypto.randomBytes(16).toString("hex")}`;
  console.log(`${c.green}✓${c.reset} New CodeAtlas API Key:`);
  console.log(`  ${c.cyan}${apiKey}${c.reset}\n`);
  console.log(`${c.dim}Use this key in the 'x-api-key' header for API authentication.${c.reset}\n`);
}

function handleMigrateFirestore() {
  printBanner();
  const scriptPath = path.join(ROOT_DIR, "scripts", "migrate-firestore-to-sqlite.ts");
  const tsxBin = path.join(ROOT_DIR, "node_modules", ".bin", "tsx");
  const runner = fs.existsSync(tsxBin) ? tsxBin : "npx";
  const runnerArgs = fs.existsSync(tsxBin) ? [scriptPath] : ["tsx", scriptPath];

  const result = spawnSync(runner, runnerArgs, {
    cwd: ROOT_DIR,
    stdio: "inherit",
    env: process.env,
  });

  if (result.status !== 0) {
    process.exit(result.status ?? 1);
  }
}

// CLI Command Dispatcher
const rawArgs = process.argv.slice(2);
const command = rawArgs[0] || "help";
const commandArgs = rawArgs.slice(1);

switch (command) {
  case "generate-key":
  case "key:generate":
    handleGenerateKey(commandArgs);
    break;

  case "generate-api-key":
  case "api-key:generate":
    handleGenerateApiKey();
    break;

  case "migrate-firestore":
  case "firestore:migrate":
    handleMigrateFirestore();
    break;

  case "help":
  case "--help":
  case "-h":
    printHelp();
    break;

  default:
    console.error(`\n${c.red}Unknown command: "${command}"${c.reset}`);
    console.error(`Run ${c.bold}node atlas help${c.reset} for available commands.\n`);
    process.exit(1);
}
