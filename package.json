{
  "name": "codeatlas-ai",
  "displayName": "CodeAtlas AI",
  "description": "AI-powered codebase intelligence platform — MCP Server, AST analysis, semantic memory and architectural insights for any codebase.",
  "version": "2.14.7",
  "license": "MIT",
  "type": "module",
  "author": "giauphan",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "codeatlas-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giauphan/codeatlas-platform.git"
  },
  "homepage": "https://github.com/giauphan/codeatlas-platform#readme",
  "bugs": {
    "url": "https://github.com/giauphan/codeatlas-platform/issues"
  },
  "keywords": [
    "codeatlas",
    "mcp",
    "modelcontextprotocol",
    "code-analysis",
    "ast",
    "ai",
    "codebase-intelligence",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --experimental-test-module-mocks --test-concurrency=1 --import tsx --test 'tests/**/*.test.ts'",
    "db-init": "tsx scripts/db-init.ts",
    "db-seed": "tsx scripts/db-seed.ts"
  },
  "overrides": {
    "uuid": "11.1.1",
    "fast-uri": ">=3.1.6",
    "brace-expansion": ">=2.1.6",
    "@grpc/grpc-js": ">=1.14.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^11.10.0",
    "pg": "^8.23.1",
    "pgvector": "^0.3.0",
    "playwright": "^1.63.0",
    "sqlite-vec": "0.1.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/compression": "^1.8.1",
    "@typescript-eslint/typescript-estree": "^8.71.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "cors": "2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "glob": "^10.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "p-limit": "^7.3.3",
    "py-ast": "^1.16.0",
    "zod": "^4.6.5"
  }
}
