# CodeAtlas Platform — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Server ───────────────────────────────────────────────
# HTTP / SSE server port (leave unset for stdio-only mode)
PORT=3381
# Internal MCP callback port
CODEATLAS_MCP_PORT=3382
# CORS allowlist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Project Scanning Concurrency (Optional: max parallel directory reads, defaults to 50)
CODEATLAS_PROJECT_SCAN_CHUNK_SIZE=50

# ── Multi-Tenant ─────────────────────────────────────────
CODEATLAS_MULTI_TENANT=false
CODEATLAS_PROJECTS_ROOT=./tenants
CODEATLAS_PROJECT_DIR=./
# Comma-separated list of MCP tools to disable (e.g., "scan_enterprise_vulnerabilities")
CODEATLAS_DISABLED_TOOLS=

# ── Database Configuration ─────────────────────────
# SQLite + sqlite-vec stores CodeAtlas data locally.
CODEATLAS_DB_TYPE=sqlite
# Path to SQLite database file (relative to project root)
CODEATLAS_SQLITE_PATH=./data/codeatlas.db

# ── Firebase / Google Service Account ────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Embeddings (Mistral + NVIDIA NIM) ────────────────────
# Either provider works; both accept a comma-separated key pool and rotate on 401/403/429
MISTRAL_API_KEY=your_mistral_key
NVIDIA_API_KEY=your_nvidia_key
# Cross-provider failover list (first = primary); rotates on 4xx/5xx or wrong-dimension responses
EMBEDDING_MODELS=mistral/codestral-embed,mistral/mistral-embed,nvidia/llama-nemotron-embed-vl-1b-v2,nvidia/nemotron-3-embed-1b
# Requested embedding dimension; must match DB schema vector(1024)/1024-float BLOB
EMBEDDING_DIM=1024

# ── Security ─────────────────────────────────────────────
# API key for x-api-key auth (optional — disable for local dev)
CODEATLAS_API_KEY=your_api_key
# Bearer token for outbound A2A MCP calls
A2A_MCP_TOKEN=

# ── Cron / Scheduler ─────────────────────────────────────
CRON_SETTINGS_PATH=

# ── Dashboard (Vite env vars, prefix with VITE_) ─────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
