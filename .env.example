# CodeAtlas Platform — Environment Config (Port đẹp, không trùng provider)
# HTTP / SSE Server Port
PORT=3381
# Internal MCP Callback Port
CODEATLAS_MCP_PORT=3382
# Security (Optional: Admin Secret Key for multi-tenant)
CODEATLAS_MULTI_TENANT=false
CODEATLAS_PROJECTS_ROOT=/home/ubuntu/codeatlas-platform/tenants
CODEATLAS_PROJECT_DIR=/home/ubuntu/codeatlas-platform
# Oracle 26ai Connection String (TCPS / Thick mode)
ORACLE_CONN_STRING=your_oracle_conn_string_here
ORACLE_USER=ADMIN
ORACLE_LIB_DIR=./instantclient
ORACLE_WALLET_DIR=./wallet
# Firebase / Google Service Account
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# NVIDIA NIM Embeddings API Key
NVIDIA_API_KEY=your_nvidia_key_here
# Security API Key (optional — disable for dev)
CODEATLAS_API_KEY=your_api_key_here
