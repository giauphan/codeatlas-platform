# CodeAtlas Platform — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env

# ── Server ───────────────────────────────────────────────
# HTTP / SSE server port (leave unset for stdio-only mode)
PORT=3381
# Internal MCP callback port
CODEATLAS_MCP_PORT=3382
# CORS allowlist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Project Scanning Concurrency (Optional: max parallel directory reads, defaults to 50)
CODEATLAS_PROJECT_SCAN_CHUNK_SIZE=50

# ── Multi-Tenant ─────────────────────────────────────────
CODEATLAS_MULTI_TENANT=false
CODEATLAS_PROJECTS_ROOT=./tenants
CODEATLAS_PROJECT_DIR=./
# Comma-separated list of MCP tools to disable (e.g., "scan_enterprise_vulnerabilities")
CODEATLAS_DISABLED_TOOLS=

# ── Database Configuration ─────────────────────────
# SQLite + sqlite-vec stores CodeAtlas data locally.
CODEATLAS_DB_TYPE=sqlite
# Path to SQLite database file (relative to project root)
CODEATLAS_SQLITE_PATH=./data/codeatlas.db

# Database Batch Tuning (Optional)
# CODEATLAS_DB_BATCH_SIZE=500
# CODEATLAS_BATCH_UPDATE_RETRIES=3
# Note: For low-latency / high-throughput environments, lower the retry limits (e.g. 1-2 retries) and max chunk sizes (e.g. 500) to prevent queue backlogs during transient network degradation.
# CODEATLAS_BATCH_UPDATE_BACKOFF_MS=500
# Coefficient bounding the Bayesian inference concept consolidation decay algorithm
# CODEATLAS_CONFIDENCE_DECAY_CONSTANT=0.2

# ── Firebase / Google Service Account ────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── NVIDIA NIM Embeddings ────────────────────────────────
NVIDIA_API_KEY=your_nvidia_key

# ── Security ─────────────────────────────────────────────
# API key for x-api-key auth (optional — disable for local dev)
CODEATLAS_API_KEY=your_api_key
# Bearer token for outbound A2A MCP calls
A2A_MCP_TOKEN=

# ── Cron / Scheduler ─────────────────────────────────────
CRON_SETTINGS_PATH=

# ── Dashboard (Vite env vars, prefix with VITE_) ─────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- Consolidation Batching Configurations ---
# CODEATLAS_DB_BATCH_SIZE: Number of rows per batch query (default 500)
# CODEATLAS_BATCH_UPDATE_RETRIES: Number of retries for failed batches (default 3)
# CODEATLAS_BATCH_UPDATE_BACKOFF_MS: Exponential backoff base time in ms (default 500)
# CODEATLAS_CONFIDENCE_DECAY_CONSTANT: Bayesian decay multiplier for scoring. Determines how fast confidence approaches 0.99 with new evidence. Lower is slower. Must be positive. (default 0.2)
# CODEATLAS_MAX_UPDATE_RECORDS: Maximum updates processed in one run (default 10000)
# CODEATLAS_BATCH_ABORT_THRESHOLD: Consecutive chunk failures before aborting job (default 5)
# CODEATLAS_BATCH_ABORT_FRACTION: Fraction of failed chunks before aborting job (default 0.5)
# CODEATLAS_BATCH_VERBOSE_LOGGING: Enable detailed debug logs for batch processing (default false)
